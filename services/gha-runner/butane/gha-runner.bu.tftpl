variant: fcos
version: 1.5.0

storage:
  directories:
    - path: /var/lib/gha-runner/work
      mode: 0750
      user:
        id: ${container_puid}
      group:
        id: ${container_pgid}

  files:
    # Podman secret seed - root-only. gha-runner-secret.service loads this
    # into a podman secret before the runner container starts, so the App
    # private key isn't a plain `Environment=` value (visible via
    # `podman inspect`). It still exists in cleartext here and in the
    # rendered Ignition config uploaded to the Proxmox snippet datastore -
    # see ADR-0005.
    - path: /etc/gha-runner/app-private-key.pem
      mode: 0600
      contents:
        # A PEM key is multi-line - a plain single-line inline value would
        # only work for single-line values and breaks YAML parsing here.
        # This needs a block scalar with the interpolated content
        # re-indented to match.
        inline: |
          ${indent(10, github_app_private_key)}

    - path: /etc/containers/systemd/gha-runner.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=GitHub Actions self-hosted runner (${github_repo})
          After=network-online.target gha-runner-secret.service
          Wants=network-online.target
          Requires=gha-runner-secret.service

          [Container]
          Image=docker.io/myoung34/github-runner:${runner_image_tag}
          ContainerName=gha-runner
          AutoUpdate=registry

          Secret=gha_runner_app_key,type=env,target=APP_PRIVATE_KEY
          Environment=APP_ID=${github_app_id}
          Environment=RUNNER_NAME=%H
          Environment=REPO_URL=https://github.com/${github_repo}
          # APP_LOGIN is left unset - the entrypoint derives it from
          # REPO_URL's owner segment for RUNNER_SCOPE=repo.
          Environment=RUNNER_SCOPE=repo
          Environment=LABELS=${runner_labels}
          Environment=RUNNER_WORKDIR=/_work
          # Redeploying the container (via the auto-update timer pulling a
          # fresh nightly image, ADR-0005) is how this runner picks up a
          # newer actions/runner binary - disable the image's own in-place
          # self-update so those two mechanisms don't fight each other.
          Environment=DISABLE_AUTO_UPDATE=true

          Volume=/var/lib/gha-runner/work:/_work:Z

          [Service]
          Restart=always
          TimeoutStartSec=300

          [Install]
          WantedBy=multi-user.target

systemd:
  units:
    - name: podman-auto-update.timer
      enabled: true

    - name: gha-runner-secret.service
      enabled: true
      contents: |
        [Unit]
        Description=Seed the podman secret backing the GitHub runner's APP_PRIVATE_KEY
        Before=gha-runner.service

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/podman secret create --replace gha_runner_app_key /etc/gha-runner/app-private-key.pem

        [Install]
        WantedBy=multi-user.target
